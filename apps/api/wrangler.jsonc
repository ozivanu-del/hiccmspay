{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prj-smartpay-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prj-smartpay-db",
      "database_id": "a2f179e9-9e43-45ce-bce2-4b869ffa0114",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "true",
    "ALLOWED_ORIGIN": "https://prj-smartpay-web.ilhamstory78.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
